<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SpeakEasy.WinUi.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SpeakEasy.WinUi"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    Title="SpeakEasy"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Page
        xmlns:controls="using:CommunityToolkit.WinUI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:CommunityToolkit.WinUI">

        <StackPanel Spacing="4" Padding="20 20 20 20">
            
            <win:StackPanel.ChildrenTransitions>
                <win:EntranceThemeTransition FromVerticalOffset="50" />
                <win:RepositionThemeTransition IsStaggeringEnabled="False" />
            </win:StackPanel.ChildrenTransitions>

			<TextBlock Text="SpeakEasy"
                    FontSize="24" 
					FontWeight="Bold" />
			<TextBlock Text="An AI-powered text-to-speech helper for GuildWars 2 content." 
                       Padding="0 0 0 20" />

			<controls:SettingsCard Header="ArenaNet API">

                <controls:SettingsCard.Description>
                    <HyperlinkButton 
                        Content="Get your ArenaNet API Key" 
                        NavigateUri="https://account.arena.net/applications" />
                </controls:SettingsCard.Description>

                <TextBox Width="250" />                
            </controls:SettingsCard>

            <controls:SettingsExpander Description="Select the AI provider you wish to use."
                                Header="AI Provider">

                <ComboBox SelectedIndex="0">
                    <ComboBoxItem>Select One</ComboBoxItem>
                    <ComboBoxItem>Eleven Labs</ComboBoxItem>
                    <ComboBoxItem>OpenAI</ComboBoxItem>
                    <ComboBoxItem>Microsoft Azure</ComboBoxItem>
                </ComboBox>

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="API Endpoint">
                        <TextBox Width="350" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="API Key">
                        <TextBox Width="350" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsCard Header="Automatically start speaking when text content is displayed?.">
                <ToggleSwitch />
            </controls:SettingsCard>

            <controls:SettingsCard Header="Auto select voice based on NPC characteristcs?">
                <ToggleSwitch />
            </controls:SettingsCard>

            <controls:SettingsCard Header="Playback speed">
                <ComboBox SelectedIndex="3">
                    <ComboBoxItem>.25</ComboBoxItem>
                    <ComboBoxItem>.5</ComboBoxItem>
                    <ComboBoxItem>.75</ComboBoxItem>
                    <ComboBoxItem>Normal</ComboBoxItem>
                    <ComboBoxItem>1.25</ComboBoxItem>
                    <ComboBoxItem>1.5</ComboBoxItem>
                    <ComboBoxItem>1.75</ComboBoxItem>
                    <ComboBoxItem>2</ComboBoxItem>
                    <ComboBoxItem>2.5</ComboBoxItem>
                    <ComboBoxItem>3</ComboBoxItem>
                </ComboBox>
            </controls:SettingsCard>
        </StackPanel>
    </Page>
</Window>
